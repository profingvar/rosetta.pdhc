FLASK_ENV=development
FLASK_APP=app:create_app
APP_PORT=9092

DB_HOST=localhost
DB_PORT=9091
DB_NAME=rosetta_pdhc_db
DB_USER=rosetta
DB_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://rosetta:changeme@localhost:9091/rosetta_pdhc_db

AUTH_MODE=off
SSO_BASE_URL=https://sso.pdhc.se
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=https://rosetta.pdhc.se/auth/callback
GATEWAY_BASE_URL=https://gateway.pdhc.se

SECRET_KEY=replace-me-with-random-string
# #422 — ips.pdhc consent verdicts (analysis-filter). Required in prod;
# unset => analysis reads fail closed (503) for non-SU users.
IPS_BASE_URL=https://ips.pdhc.se

# #523 — inbound service key for POST /api/v1/openehr/realisable.
# That endpoint is a PUBLIC path (skips the SSO login redirect) because
# plan.pdhc calls it server-to-server. This key locks it to the trusted
# sibling: rosetta requires the caller's X-Service-Key header to equal this
# value. It is a SHARED SECRET — it must be byte-identical to plan.pdhc's
# ROSETTA_SERVICE_KEY, or plan.pdhc's calls get 401.
#   blank  => endpoint is OPEN (only concept->archetype modelling metadata;
#             no patient data — but anyone who can reach the URL may POST).
#   set    => auth required (recommended in prod). Generate with:
#             python3 -c "import secrets;print(secrets.token_hex(32))"
# ROTATION: change here AND in plan.pdhc's .env, then recreate BOTH containers
# (docker compose up -d --force-recreate app — `docker restart` won't reload env).
ROSETTA_SERVICE_KEY=

# #505/#506 — openEHR delivery to the target CDR (rosetta's only write path).
# Subject namespace on EHR_STATUS.subject.external_ref (contractual, agreed with
# the receiving CDR).
OPENEHR_SUBJECT_NAMESPACE=urn:pdhc:patient-guid
# Master switch. OFF by default so the client can ship + be wired before the
# sandbox is live; delivery is a hard no-op until this is true. Flip to 1/true
# only once the target + creds below are confirmed. NEVER point at a prod CDR.
OPENEHR_DELIVERY_ENABLED=
# Transport: `asha` (Phanera's form-login app — the current sandbox, #512) or
# `spec_rest` (a real /rest/openehr/v1 CDR — not implemented yet).
OPENEHR_DELIVERY_TRANSPORT=asha
# Target base URL + instance. The sandbox is https://openehr.phanera.se / cdr1.
OEHR_BASE=https://openehr.phanera.se
OEHR_INSTANCE=cdr1
# ASHA form-login demo credentials (operator-held; do NOT commit real values).
OEHR_USER=
OEHR_PASS=
# Bearer token — reserved for the future spec_rest transport (unused by asha).
OEHR_TOKEN=
